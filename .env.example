# OpenAI API credentials are separate from a ChatGPT subscription.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Paths are relative to the directory from which you launch the application.
DATA_DIR=fixtures/public
POLICY_PDF=data/políticas_da_loja.pdf
DATABASE_PATH=runtime/store.sqlite3
MAX_TOOL_ROUNDS=5
MAX_HISTORY_TURNS=8
# openai: real model; demo: explicitly limited deterministic offline demonstration.
AGENT_MODE=openai
